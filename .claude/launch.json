{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Punto Panel (Admin)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-S", "localhost:8001", "-t", "panel", "panel/router.php"],
      "cwd": ".",
      "port": 8001,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto App (POS)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-S", "localhost:8002", "-t", "app", "app/router.php"],
      "cwd": ".",
      "port": 8002,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto API (compartida)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-S", "localhost:8000", "-t", "api", "api/router.php"],
      "cwd": ".",
      "port": 8000,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto Panel Preview (8011)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-S", "localhost:8011", "-t", "panel", "panel/router.php"],
      "cwd": ".",
      "port": 8011,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8",
        "PUNTO_API_BASE": "http://localhost:8011/API"
      }
    },
    {
      "name": "Punto Screens (KDS/CDS/recibos)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-S", "localhost:8003", "-t", "screens"],
      "cwd": ".",
      "port": 8003,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "4"
      }
    }
  ]
}
