{
  "version": "0.0.1",
  "_note_opcache": "opcache.enable_cli=1 acelera el dev server (php -S): cada worker parsea functions.php una vez y reusa el bytecode (bootstrap ~74ms→~7ms). validate_timestamps=1 + revalidate_freq=0 → opcache chequea mtime en cada request y recarga archivos cambiados → código siempre fresco, sin stale. En prod (php-fpm/apache) opcache ya está ON. Ver context/10-roadmap.md § bootstrap. REQUIERE reiniciar los servers para tomar efecto.",
  "configurations": [
    {
      "name": "Punto Panel (Admin)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-d", "opcache.enable_cli=1", "-d", "opcache.validate_timestamps=1", "-d", "opcache.revalidate_freq=0", "-d", "opcache.memory_consumption=128", "-S", "localhost:8001", "-t", "panel", "panel/router.php"],
      "cwd": ".",
      "port": 8001,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto App (POS)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-d", "opcache.enable_cli=1", "-d", "opcache.validate_timestamps=1", "-d", "opcache.revalidate_freq=0", "-d", "opcache.memory_consumption=128", "-S", "localhost:8002", "-t", "app", "app/router.php"],
      "cwd": ".",
      "port": 8002,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto API (compartida)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-d", "opcache.enable_cli=1", "-d", "opcache.validate_timestamps=1", "-d", "opcache.revalidate_freq=0", "-d", "opcache.memory_consumption=128", "-S", "localhost:8000", "-t", "api", "api/router.php"],
      "cwd": ".",
      "port": 8000,
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      }
    },
    {
      "name": "Punto Panel Preview (8011)",
      "runtimeExecutable": "/opt/homebrew/bin/php",
      "runtimeArgs": ["-d", "display_errors=on", "-d", "opcache.enable_cli=1", "-d", "opcache.validate_timestamps=1", "-d", "opcache.revalidate_freq=0", "-d", "opcache.memory_consumption=128", "-S", "localhost:8011", "-t", "panel", "panel/router.php"],
      "cwd": ".",
