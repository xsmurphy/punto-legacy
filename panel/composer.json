{
    "name": "punto/panel",
    "description": "Punto POS — Panel administrativo",
    "require": {
        "php": ">=8.1",
        "mailgun/mailgun-php": "^4.2",
        "nyholm/psr7": "^1.8",
        "giggsey/libphonenumber-for-php": "^8.13",
        "symfony/http-client": "^6.4",
        "filp/whoops": "^2.15",
        "minishlink/web-push": "^9.0",
        "hashids/hashids": "^4.1",
        "parsecsv/php-parsecsv": "^1.3",
        "aws/aws-sdk-php": "^3.300"
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './cach/*' -exec php -l {} \\; | grep -v 'No syntax errors detected' || true",
        "lint:strict": "find . -name '*.php' -not -path './vendor/*' -not -path './cach/*' -print0 | xargs -0 -n1 -P4 php -l > /dev/null"
    }
}
