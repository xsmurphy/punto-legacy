{
    "name": "punto/app",
    "description": "Punto POS — App cliente (POS)",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mailgun/mailgun-php": "^4.2",
        "nyholm/psr7": "^1.8",
        "php-http/guzzle7-adapter": "^1.0",
        "filp/whoops": "^2.15",
        "twilio/sdk": "^8.0",
        "phpmailer/phpmailer": "^6.9",
        "hashids/hashids": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Punto\\App\\Helpers\\":  "Helpers/",
            "Punto\\App\\Domain\\":   "Domain/",
            "Punto\\App\\Http\\":     "Http/",
            "Punto\\App\\Services\\": "Services/",
            "Punto\\App\\Database\\": "Database/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './cach/*' -exec php -l {} \\; | grep -v 'No syntax errors detected' || true",
        "lint:strict": "find . -name '*.php' -not -path './vendor/*' -not -path './cach/*' -print0 | xargs -0 -n1 -P4 php -l > /dev/null"
    }
}
