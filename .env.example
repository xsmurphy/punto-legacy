# ========================================
# PostgreSQL
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=puntoDB
POSTGRES_USER=punto
POSTGRES_PASSWORD=punto123

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# App
APP_ENV=local
APP_DEBUG=true
HASHIDS_SALT=

# JWT (realm tenant)
JWT_SECRET=
# Modelo de auth de /app = "device pairing": el admin activa la caja UNA vez
# por dispositivo y queda permanentemente activada (los cajeros entran con
# PIN, NO con el JWT). Por eso el TTL es deliberadamente largo: 10 años =
# 315360000 s. Acortalo si la instancia tiene controles de revocación
# alternativos. Para revocar tokens en masa: rotar JWT_SECRET.
JWT_TTL=315360000

# Admin realm (/admin) — auth separada de los tenants. Mantiene TTL corto
# (8h) porque sí es una sesión real: super-admin se loguea desde un
# browser distinto y debe re-loguearse al día siguiente.
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=28800
# Super-admin inicial (sembrado por panel/admin/bootstrap_seed.php, idempotente)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# APIs externas (completar según entorno)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
SENDGRID_SMTP_USER=
SENDGRID_SMTP_PASS=
MAILGUN_TOKEN=
NCM_SMS_API_KEY=
NCM_SMS_COMPANY_ID=
INFOBIP_AUTH=
NCM_SECRET=
IPAPI_KEY=
PDF_API_KEY=
DO_SPACES_ACCESS=
DO_SPACES_SECRET=
BANCARD_CARD_API_TOKEN=
BANCARD_QR_API_TOKEN=
AUDITORIA_TOKEN_PANEL=
AUDITORIA_TOKEN_APP=
FACTURACION_ELECTRONICA_TOKEN=
INTERCOM_IDENTITY_SECRET=
INTERCOM_IDENTITY_SECRET_IOS=
INTERCOM_IDENTITY_SECRET_ANDROID=
