# ============================================================================
# Punto POS — Variables de entorno
# ============================================================================
# Local dev: copiar a .env y completar con valores de desarrollo
# Coolify:   pegar estas keys en el panel de cada servicio con valores reales
# ============================================================================


# ── App / Entorno ───────────────────────────────────────────────────────────
APP_NAME=Punto
APP_ENV=local                   # local | staging | production
APP_DEBUG=true                  # true en staging para que send_verification shortcircuite a PIN=0000


# ── Observabilidad (GlitchTip, self-hosted, API Sentry-compatible) ─────────
# SOLO API (PHP). bootstrap.php gatea la init por esta var: sin DSN, Sentry
# no se inicializa (cero impacto, no-op). No hardcodear el DSN en código.
SENTRY_DSN=

# ── Dominios / URLs ─────────────────────────────────────────────────────────
# Topología (2026-06-29): UN solo dominio público `app.punto.la` = el frontend
# (Next.js), path-based: / panel, /pos, /admin, /checkout, /connect. El PHP es
# SOLO la API, interno; el BFF del frontend (server-side) lo llama por API_URL.
# El browser NUNCA toca el PHP directo (por eso CORS casi no aplica).
#
# APP_URL  = dominio público del frontend (links absolutos: /connect, emails).
APP_URL=https://app.punto.la
# API_URL  = URL INTERNA del PHP API que usa el BFF del frontend (server-side).
#            En prod: el host interno del container api (ej. http://api:80).
API_URL=http://localhost:8000
WS_URL=ws://localhost:6001
# DEPRECADOS: PANEL_URL/ADMIN_URL eran subdominios del modelo viejo (panel.*/admin.*);
# ya no se usan — admin y panel viven bajo APP_URL. No setear en prod.


# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list. Si NO está definida, cors.php cae al allowlist legacy
# (encom.app + localhost) para no romper local dev.
# Ej. staging: https://panel.punto.la,https://app.punto.la,https://admin.punto.la,https://api.punto.la
CORS_ALLOWED_ORIGINS=


# ── BFF → API ───────────────────────────────────────────────────────────────
# OJO: el panel y el app llaman a APIs DISTINTAS:
#   - panel BFF → API LOCAL del panel (/panel/API/v1/) — config del chrome, reports
#   - app BFF   → API COMPARTIDA (/api/v1/)            — items, sales, sync, drawer
#
# PUNTO_API_BASE — apunta a la API LOCAL del panel.
#   single-container deploy: http://localhost:3000/API (self-HTTP intra-container)
#   dev local:               http://localhost:8001/API
PUNTO_API_BASE=http://localhost:8001/API

# PUNTO_SHARED_API_BASE — apunta a la API compartida.
#   single-container deploy: http://localhost:3000 (loopback IN-container, NO sale
#                            a Cloudflare) + PUNTO_SHARED_API_HOST=api.punto.la
#   dev local:               http://localhost:8000
# Si está vacío, app BFF cae a PUNTO_API_BASE (legacy) → 502 al pegar a paths
# que no existen en la API local del panel. SETEAR SIEMPRE.
#
# ⚠️ NO usar https://api.punto.la en single-container: el BFF saldría a Cloudflare
# y volvería al MISMO container (round-trip + CF como punto de fallo + consume un
# 2º worker del pool por venta → 502 bajo carga). Usar localhost + Host header.
PUNTO_SHARED_API_BASE=http://localhost:8000

# PUNTO_SHARED_API_HOST — Host header a forzar cuando SHARED_API_BASE es localhost.
# El router.php raíz despacha por Host; sin esto, el loopback a localhost no rutea
# a /api. En single-container: api.punto.la. En dev (php -S directo): dejar vacío.
PUNTO_SHARED_API_HOST=


# ── PHP server (php -S built-in) ────────────────────────────────────────────
# Workers > 1 es OBLIGATORIO en cualquier entorno donde el BFF haga self-HTTP
# o donde haya más de 1 request concurrente. Sin esto: deadlock garantizado.
PHP_CLI_SERVER_WORKERS=8


# ── PostgreSQL ──────────────────────────────────────────────────────────────
# OPCIÓN A — URL completa (Coolify managed DB, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/puntoDB
# Si DATABASE_URL está seteada, tiene prioridad sobre las vars individuales.

# OPCIÓN B — vars individuales (dev local / host manual)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=puntoDB
POSTGRES_USER=punto
POSTGRES_PASSWORD=punto123


# ── Redis ───────────────────────────────────────────────────────────────────
# OPCIÓN A — URL completa (Coolify managed Redis, Railway, etc.)
# REDIS_URL=redis://host:6379
# Si REDIS_URL está seteada, tiene prioridad sobre las vars individuales.
# ws-server (Node/ioredis) SIEMPRE usa REDIS_URL — setearla también en Coolify.

# OPCIÓN B — vars individuales
REDIS_HOST=127.0.0.1
REDIS_PORT=6379


# ── Auth — Tenant realm (/panel, /app) ──────────────────────────────────────
# 64 chars hex aleatorios. Generar: openssl rand -hex 32
# DEPRECATED (F6 auth-rewrite): jwt.php eliminado; la firma JWT ya no se usa en app/ ni api/.
# Mantener en .env por back-compat con panel/bff/pos-redirect.php y panel/upload.php
# hasta que esos dos archivos sean migrados al sistema de sesiones opacas.
JWT_SECRET=
# Modelo "device pairing" de /app: el admin activa la caja UNA vez por
# dispositivo (cookie _jwt) y queda permanentemente asociada. Los cajeros
# entran/salen con PIN (no tocan el JWT).
#
# JWT_TTL=0 (recomendado): token ETERNO, sin claim `exp`. Es lo correcto para
#   el modelo device-pairing: una caja activada se queda activada.
# JWT_TTL>0: token expira pasado ese tiempo en segundos (ej. 315360000 = 10 años).
#
# Revocación masiva: rotar JWT_SECRET. Per-device: tabla `device` + UI admin.
JWT_TTL=0
# TTL del JWT del PANEL (sesión interactiva del operador). Default 86400s = 24h
# para que el operador no se quede colgado a mitad de jornada perdiendo trabajo.
# Más bajo si querés más seguridad; más alto si la jornada típica supera 24h.
PANEL_JWT_TTL=86400


# ── Auth — Admin realm (/admin) ─────────────────────────────────────────────
# Sesión real del super-admin: 8h. Cookie _jwt_admin, separada del tenant.
# DEPRECATED (F6 auth-rewrite): admin_auth.php ya usa sesiones opacas; jwt.php eliminado del admin realm.
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=28800
# Super-admin inicial — bootstrap_seed.php es idempotente
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# ── Legacy salts ────────────────────────────────────────────────────────────
HASHIDS_SALT=
NCM_SECRET=


# ── WebSocket server (ws-server, Node) ──────────────────────────────────────
WS_PORT=6001


# ── Master / multi-tenant ───────────────────────────────────────────────────
# Empresa master que aparece en /admin/companies como dueña. UUID v0.
MASTER_COMPANY_ID=00000000-0000-0000-0000-000000000001


# ── Email (SendGrid / Mailgun) ──────────────────────────────────────────────
EMAIL_FROM=info@punto.app
EMAIL_NOTIFICATION=info@punto.app
EMAIL_NOTIFICATION_TO=admin@punto.app
SENDGRID_API_KEY=
SENDGRID_SMTP_USER=
SENDGRID_SMTP_PASS=
MAILGUN_TOKEN=
MAILGUN_DOMAIN=


# ── SMS / WhatsApp ──────────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
INFOBIP_AUTH=
NCM_SMS_API_KEY=
NCM_SMS_COMPANY_ID=
# Evolution API (WhatsApp) — reemplaza Twilio para mensajería
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=


# ── Pagos (Bancard) ─────────────────────────────────────────────────────────
BANCARD_CARD_API_TOKEN=
BANCARD_QR_API_TOKEN=
API_PIX_SECRET=


# ── Facturación electrónica (Factomate / SIFEN) ─────────────────────────────
# APP_ENCRYPTION_KEY: base64 de 32 bytes (openssl rand -base64 32). Sin ella el
# vault de credenciales no arranca y el módulo queda `unconfigured`.
APP_ENCRYPTION_KEY=
# Test y prod son HOSTS DISTINTOS. Con FACTOMATE_BASE_URL_PROD vacía, una cuenta
# en environment='prod' falla explícito — nunca cae a test.
FACTOMATE_BASE_URL_TEST=https://facturadordev.automate.com.py
FACTOMATE_BASE_URL_PROD=
# Credencial ADMIN de Punto en el proveedor de FE (F7 white-label): usuario
# global sin tenant, crea emisores y autentica a cualquier tenant. El secreto
# más sensible del módulo — solo env, nunca BD.
FACTOMATE_ADMIN_USERNAME_TEST=
FACTOMATE_ADMIN_PASSWORD_TEST=
FACTOMATE_ADMIN_USERNAME_PROD=
FACTOMATE_ADMIN_PASSWORD_PROD=
# Entorno donde se provisionan los emisores nuevos ('test' | 'prod').
EINVOICE_DEFAULT_ENVIRONMENT=test
# Secreto compartido del drainer del outbox (POST /v1/einvoice?action=drain,
# lo invoca el cron). Vacío → el endpoint responde 503 siempre.
EINVOICE_DRAIN_SECRET=
# Padrón público para el lookup de RUC (fallback cuando el comercio no tiene FE
# conectada). Vacío → solo se consulta el padrón del emisor.
TAXPAYER_LOOKUP_URL=https://turuc.com.py/api/contribuyente


# ── Storage / CDN ───────────────────────────────────────────────────────────
DO_SPACES_ACCESS=
DO_SPACES_SECRET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
PDF_API_KEY=


# ── dLocal Go (pasarela de pagos — compra de packs de créditos) ─────────────
# ENVIRONMENT: sandbox | production. El webhook se firma HMAC-SHA256 con WEBHOOK_SECRET.
DLOCAL_GO_API_KEY=
DLOCAL_GO_SECRET_KEY=
DLOCAL_GO_WEBHOOK_SECRET=
DLOCAL_GO_ENVIRONMENT=sandbox
DLOCAL_GO_BASE_URL=
# URLs de retorno del checkout (el front del tenant) y de notificación (webhook directo a la API).
# Ej: https://frontend-dev.punto.la/history-billing?checkout=success
DLOCAL_GO_SUCCESS_URL=
DLOCAL_GO_BACK_URL=
# Ej: https://api.punto.la/v1/billing-webhook.php
DLOCAL_GO_NOTIFICATION_URL=


# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_SUBJECT=mailto:info@punto.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# ── Auditoría externa ───────────────────────────────────────────────────────
AUDITORIA_TOKEN_PANEL=
AUDITORIA_TOKEN_APP=


# ── Geolocalización ─────────────────────────────────────────────────────────
IPAPI_KEY=


# ── Intercom (chat in-app) ──────────────────────────────────────────────────
INTERCOM_IDENTITY_SECRET=
INTERCOM_IDENTITY_SECRET_IOS=
INTERCOM_IDENTITY_SECRET_ANDROID=


# ── Analytics / pixels ──────────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
HEADWAY_ACCOUNT_ID=


# ── API Layer ───────────────────────────────────────────────────────────────
API_LAYER_KEY=
