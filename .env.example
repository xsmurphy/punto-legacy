# ============================================================================
# Punto POS — Variables de entorno
# ============================================================================
# Local dev: copiar a .env y completar con valores de desarrollo
# Coolify:   pegar estas keys en el panel de cada servicio con valores reales
# ============================================================================


# ── App / Entorno ───────────────────────────────────────────────────────────
APP_NAME=Punto
APP_ENV=local                   # local | staging | production
APP_DEBUG=true                  # true en staging para que send_verification shortcircuite a PIN=0000


# ── Dominios públicos ───────────────────────────────────────────────────────
# Usados para generar URLs absolutas (emails, links), CSP y CORS.
# En local: http://localhost:800X. En prod: https://*.punto.la
PANEL_URL=http://localhost:8001
APP_URL=http://localhost:8002
ADMIN_URL=http://localhost:8001/admin
API_URL=http://localhost:8000
WS_URL=ws://localhost:6001
PUBLIC_URL=http://localhost:8001


# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list. Si NO está definida, cors.php cae al allowlist legacy
# (encom.app + localhost) para no romper local dev.
# Ej. staging: https://panel.punto.la,https://app.punto.la,https://admin.punto.la,https://api.punto.la
CORS_ALLOWED_ORIGINS=


# ── BFF → API ───────────────────────────────────────────────────────────────
# OJO: el panel y el app llaman a APIs DISTINTAS:
#   - panel BFF → API LOCAL del panel (/panel/API/v1/) — config del chrome, reports
#   - app BFF   → API COMPARTIDA (/api/v1/)            — items, sales, sync, drawer
#
# PUNTO_API_BASE — apunta a la API LOCAL del panel.
#   single-container deploy: http://localhost:3000/API (self-HTTP intra-container)
#   dev local:               http://localhost:8001/API
PUNTO_API_BASE=http://localhost:8001/API

# PUNTO_SHARED_API_BASE — apunta a la API compartida.
#   single-container deploy: https://api.punto.la (self-HTTP vía Traefik por DNS)
#   dev local:               http://localhost:8000
# Si está vacío, app BFF cae a PUNTO_API_BASE (legacy) → 502 al pegar a paths
# que no existen en la API local del panel. SETEAR SIEMPRE.
PUNTO_SHARED_API_BASE=http://localhost:8000


# ── PHP server (php -S built-in) ────────────────────────────────────────────
# Workers > 1 es OBLIGATORIO en cualquier entorno donde el BFF haga self-HTTP
# o donde haya más de 1 request concurrente. Sin esto: deadlock garantizado.
PHP_CLI_SERVER_WORKERS=8


# ── PostgreSQL ──────────────────────────────────────────────────────────────
# OPCIÓN A — URL completa (Coolify managed DB, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/puntoDB
# Si DATABASE_URL está seteada, tiene prioridad sobre las vars individuales.

# OPCIÓN B — vars individuales (dev local / host manual)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=puntoDB
POSTGRES_USER=punto
POSTGRES_PASSWORD=punto123


# ── Redis ───────────────────────────────────────────────────────────────────
# OPCIÓN A — URL completa (Coolify managed Redis, Railway, etc.)
# REDIS_URL=redis://host:6379
# Si REDIS_URL está seteada, tiene prioridad sobre las vars individuales.
# ws-server (Node/ioredis) SIEMPRE usa REDIS_URL — setearla también en Coolify.

# OPCIÓN B — vars individuales
REDIS_HOST=127.0.0.1
REDIS_PORT=6379


# ── Auth — Tenant realm (/panel, /app) ──────────────────────────────────────
# 64 chars hex aleatorios. Generar: openssl rand -hex 32
JWT_SECRET=
# Modelo "device pairing" de /app: el admin activa la caja UNA vez por
# dispositivo (cookie _jwt) y queda permanentemente asociada. Los cajeros
# entran/salen con PIN (no tocan el JWT).
#
# JWT_TTL=0 (recomendado): token ETERNO, sin claim `exp`. Es lo correcto para
#   el modelo device-pairing: una caja activada se queda activada.
# JWT_TTL>0: token expira pasado ese tiempo en segundos (ej. 315360000 = 10 años).
#
# Revocación masiva: rotar JWT_SECRET. Per-device: tabla `device` + UI admin.
JWT_TTL=0
# TTL del JWT del PANEL (sesión interactiva del operador). Default 86400s = 24h
# para que el operador no se quede colgado a mitad de jornada perdiendo trabajo.
# Más bajo si querés más seguridad; más alto si la jornada típica supera 24h.
PANEL_JWT_TTL=86400


# ── Auth — Admin realm (/admin) ─────────────────────────────────────────────
# Sesión real del super-admin: 8h. Cookie _jwt_admin, separada del tenant.
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=28800
# Super-admin inicial — bootstrap_seed.php es idempotente
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# ── Legacy salts ────────────────────────────────────────────────────────────
HASHIDS_SALT=
NCM_SECRET=


# ── WebSocket server (ws-server, Node) ──────────────────────────────────────
WS_PORT=6001


# ── Master / multi-tenant ───────────────────────────────────────────────────
# Empresa master que aparece en /admin/companies como dueña. UUID v0.
MASTER_COMPANY_ID=00000000-0000-0000-0000-000000000001


# ── Email (SendGrid / Mailgun) ──────────────────────────────────────────────
EMAIL_FROM=info@punto.app
EMAIL_NOTIFICATION=info@punto.app
EMAIL_NOTIFICATION_TO=admin@punto.app
SENDGRID_API_KEY=
SENDGRID_SMTP_USER=
SENDGRID_SMTP_PASS=
MAILGUN_TOKEN=
MAILGUN_DOMAIN=


# ── SMS / WhatsApp ──────────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
INFOBIP_AUTH=
NCM_SMS_API_KEY=
NCM_SMS_COMPANY_ID=
# Evolution API (WhatsApp) — reemplaza Twilio para mensajería
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=


# ── Pagos (Bancard) ─────────────────────────────────────────────────────────
BANCARD_CARD_API_TOKEN=
BANCARD_QR_API_TOKEN=
API_PIX_SECRET=


# ── Facturación electrónica (SIFEN) ─────────────────────────────────────────
FACTURACION_ELECTRONICA_TOKEN=


# ── Storage / CDN ───────────────────────────────────────────────────────────
DO_SPACES_ACCESS=
DO_SPACES_SECRET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
PDF_API_KEY=


# ── dLocal Go (pasarela de pagos — compra de packs de créditos) ─────────────
# ENVIRONMENT: sandbox | production. El webhook se firma HMAC-SHA256 con WEBHOOK_SECRET.
DLOCAL_GO_API_KEY=
DLOCAL_GO_SECRET_KEY=
DLOCAL_GO_WEBHOOK_SECRET=
DLOCAL_GO_ENVIRONMENT=sandbox
DLOCAL_GO_BASE_URL=
# URLs de retorno del checkout (el front del tenant) y de notificación (webhook directo a la API).
# Ej: https://panel-next-dev.punto.la/history-billing?checkout=success
DLOCAL_GO_SUCCESS_URL=
DLOCAL_GO_BACK_URL=
# Ej: https://api.punto.la/v1/billing-webhook.php
DLOCAL_GO_NOTIFICATION_URL=


# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_SUBJECT=mailto:info@punto.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# ── Auditoría externa ───────────────────────────────────────────────────────
AUDITORIA_TOKEN_PANEL=
AUDITORIA_TOKEN_APP=


# ── Geolocalización ─────────────────────────────────────────────────────────
IPAPI_KEY=


# ── Intercom (chat in-app) ──────────────────────────────────────────────────
INTERCOM_IDENTITY_SECRET=
INTERCOM_IDENTITY_SECRET_IOS=
INTERCOM_IDENTITY_SECRET_ANDROID=


# ── Analytics / pixels ──────────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
HEADWAY_ACCOUNT_ID=


# ── API Layer ───────────────────────────────────────────────────────────────
API_LAYER_KEY=
