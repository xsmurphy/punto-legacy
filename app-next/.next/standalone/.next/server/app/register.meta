{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(pos)/layout,_N_T_/(pos)/register/layout,_N_T_/(pos)/register/page,_N_T_/register"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHBvcyk/register/__PAGE__",
    "/!KHBvcyk/register",
    "/!KHBvcyk",
    "/_index",
    "/_head"
  ]
}