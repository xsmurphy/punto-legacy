# app-next — Punto POS (React/Next.js)
# Copiar a .env.local para desarrollo local.

# ── BFF → API (server-side only, NO exponer al browser) ──────────────────────
# Base URL de la /api compartida para llamadas BFF→API desde el container.
# En producción: loopback interno (evita salir a Cloudflare).
# Ejemplo prod: http://localhost:3000 (mismo container) + Host override.
PUNTO_SHARED_API_BASE=http://localhost:8000

# Host override para el request BFF→API (Vhost). Necesario cuando el loopback
# usa localhost pero el servidor espera un Host header específico.
# Ejemplo prod: api.punto.la
PUNTO_SHARED_API_HOST=api.punto.la

# Alternativa simple: URL completa de la API (env canónico, igual que panel-next).
# Si API_URL está seteado, el BFF lo usa directo y puede ignorar las dos vars de arriba.
# Ejemplo: https://api.punto.la
API_URL=http://localhost:8000

# ── Público (expuesto al browser via NEXT_PUBLIC_) ───────────────────────────
# Solo usar para valores NO secretos que el front necesita. El front debe
# apuntar SIEMPRE al BFF same-origin (/api), nunca a API_URL directo.
# NEXT_PUBLIC_APP_URL=https://app-next.punto.la

# Fallback de dev: hidrata el catálogo desde fixtures en lugar del BFF real.
# Útil cuando no hay JWT pos-app válido contra el backend. NO usar en producción.
# NEXT_PUBLIC_USE_FIXTURES=1
